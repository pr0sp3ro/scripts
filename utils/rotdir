#!/bin/sh

# Based on rotdir from Luke Smith's voidrice, https://github.com/LukeSmithxyz/voidrice
# Licensed under GPL-3.0 (https://www.gnu.org/licenses/gpl-3.0.html), not MIT.

[ -z "$1" ] && echo "usage: rotdir regex 2>&1" && exit 1
base="$(basename "$1")"
ls "$PWD" | sort | awk -v BASE="$base" 'BEGIN { lines = ""; m = 0; } { if ($0 == BASE) { m = 1; } } { if (!m) { if (lines) { lines = lines"\n"; } lines = lines""$0; } else { print $0; } } END { print lines; }'
